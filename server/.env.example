
# Zernio (social posting). Leave blank to disable. Key from https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=
ZERNIO_API_URL=https://zernio.com/api/v1
# Zernio account _id of the connected TikTok account (list via GET /api/admin/social/accounts)
ZERNIO_TIKTOK_ACCOUNT_ID=
# Auto-post newly approved distributors (logo image) to TikTok every 10 min, one per tick
ZERNIO_AUTOPOST=false

# Nurvexa Labs daily TikTok carousel: off | draft | publish. Hour is Nepal time (UTC+5:45).
NURVEXA_POST_MODE=off
NURVEXA_POST_HOUR=18
