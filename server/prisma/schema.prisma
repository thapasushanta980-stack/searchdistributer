generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ---------------------------------------------------------------
/// Tenancy: an Organisation owns its listings, products and enquiries.
/// Organisation ids are always derived server-side, never from the client.
/// ---------------------------------------------------------------

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  ARCHIVED
}

enum BusinessType {
  DISTRIBUTOR
  WHOLESALER
  IMPORTER
  SUPPLIER
  MANUFACTURER
}

enum CoverageScope {
  LOCAL
  NATIONAL
  INTERNATIONAL
}

enum VerificationStatus {
  NONE
  PROFILE_REVIEWED
  VERIFIED
}

enum EnquiryStatus {
  PENDING_VERIFICATION
  NEW
  CONTACTED
  CLOSED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum LeadType {
  BUSINESS_REGISTRATION
  REQUIREMENT
  CONTACT
}

enum RequirementKind {
  DISTRIBUTOR
  PRODUCT
  SUPPLIER
  BRAND
}

enum RequirementStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum AdPlacementCode {
  HOME_HERO_BANNER
  HOME_SPOTLIGHT
  HOME_FOOTER_BANNER
  SEARCH_TOP_BANNER
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PAUSED
  REJECTED
  COMPLETED
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model Organisation {
  id                  String             @id @default(uuid())
  name                String
  status              OrganisationStatus @default(ACTIVE)
  profileReviewStatus ReviewStatus       @default(DRAFT)
  /// Where new-enquiry notifications are delivered. Contact details are only shared with this business.
  notificationEmail   String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  distributors        Distributor[]
  products            Product[]
  enquiries           Enquiry[]
  subscriptionPeriods SubscriptionPeriod[]
  adCampaigns         AdCampaign[]

  @@map("organisations")
}

/// Entitlement window. Timestamps are UTC and end-exclusive: [startsAt, endsAt).
model SubscriptionPeriod {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime     @default(now())

  @@index([organisationId, startsAt, endsAt])
  @@map("subscription_periods")
}

model Category {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isHidden    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  distributors Distributor[]
  products     Product[]
  requirements Requirement[]

  @@index([parentId])
  @@map("categories")
}

model Distributor {
  id                 String             @id @default(uuid())
  organisationId     String
  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name               String
  slug               String             @unique
  logoUrl            String?
  summary            String
  description        String
  categoryId         String?
  category           Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Human-readable location, e.g. "Kathmandu, Nepal".
  location           String
  city               String?
  country            String?
  coverage           CoverageScope      @default(NATIONAL)
  /// Regions / countries where the business distributes.
  territories        String[]           @default([])
  businessType       BusinessType       @default(DISTRIBUTOR)
  website            String?
  contactPerson      String?
  /// WhatsApp number in international form (+977…). Never printed in pages: visitors reach it through the tracked /go/whatsapp redirect.
  whatsappNumber     String?            @db.VarChar(24)
  foundedYear        Int?
  specialties        String[]           @default([])
  distributorshipInfo String?
  minimumOrder       String?
  supportOffered     String?
  verificationStatus VerificationStatus @default(NONE)
  investmentMin      Int?
  investmentMax      Int?
  investmentCurrency String?            @db.VarChar(3)

  /// Content lifecycle (moderation).
  status             ListingStatus      @default(DRAFT)
  publicationEnabled Boolean            @default(false)
  /// Admin-managed placement. Always rendered with a "Featured" label.
  isFeatured         Boolean            @default(false)
  featuredUntil      DateTime?
  /// Local-development fixture. Never publicly visible unless SHOW_DEMO_DATA=true.
  isDemo             Boolean            @default(false)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  products           Product[]
  enquiries          Enquiry[]

  @@index([organisationId])
  @@index([categoryId])
  @@index([status, publicationEnabled])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "distributors_name_trgm_idx")
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "distributors_summary_trgm_idx")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "distributors_location_trgm_idx")
  @@map("distributors")
}

model Product {
  id                 String       @id @default(uuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  distributorId      String
  distributor        Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  /// Globally unique public path segment: /products/:publicSlug
  publicSlug         String       @unique
  description        String?
  categoryId         String?
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packaging          String?
  /// Optional price / range, or null for "Contact for details".
  priceLabel         String?
  status             ListingStatus @default(DRAFT)
  publicationEnabled Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([distributorId, slug])
  @@index([categoryId])
  @@index([status, publicationEnabled])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

model Enquiry {
  id                     String        @id @default(uuid())
  reference              String        @unique
  /// Recipient is resolved server-side from the published listing.
  organisationId         String
  organisation           Organisation  @relation(fields: [organisationId], references: [id])
  distributorId          String
  distributor            Distributor   @relation(fields: [distributorId], references: [id])
  idempotencyKey         String        @unique
  senderName             String
  senderEmail            String
  senderPhone            String?
  senderLocation         String
  message                String
  consentAt              DateTime
  status                 EnquiryStatus @default(PENDING_VERIFICATION)
  spamFlag               Boolean       @default(false)
  verificationTokenHash  String?       @unique
  verificationExpiresAt  DateTime?
  verifiedAt             DateTime?
  verificationSends      Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([organisationId, status])
  @@index([distributorId])
  @@map("enquiries")
}

/// Buyer-requirement, business-registration and contact submissions.
model Lead {
  id             String   @id @default(uuid())
  reference      String   @unique
  type           LeadType
  idempotencyKey String   @unique
  name           String
  companyName    String?
  email          String
  phone          String?
  categorySlug   String?
  location       String?
  message        String
  consentAt      DateTime
  createdAt      DateTime @default(now())
  /// Worked by admins in the inbox. CONVERTED means a listing was created from it.
  status         LeadStatus @default(NEW)
  /// Private admin notes. Never shown publicly.
  notes          String?
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@map("leads")
}

/// Retryable notification intent. A failed email never loses or duplicates the saved record.
model NotificationOutbox {
  id          String       @id @default(uuid())
  /// Deduplication key, e.g. "enquiry-verify:<enquiryId>".
  dedupeKey   String       @unique
  template    String
  toEmail     String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  nextAttemptAt DateTime   @default(now())
  sentAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

/// A buyer / would-be distributor requirement ("lead"). Public only after moderation; contact details never leave the server.
model Requirement {
  id               String            @id @default(uuid())
  reference        String            @unique
  slug             String            @unique
  idempotencyKey   String            @unique
  kind             RequirementKind
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title            String
  description      String
  budgetMin        Int?
  budgetMax        Int?
  budgetCurrency   String?           @db.VarChar(3)
  preferredLocation String
  experience       String?
  warehouse        String?
  distributionArea String?
  additional       String?
  /// Private contact snapshot (only shared with a responding business through the platform).
  contactName      String
  contactEmail     String
  contactPhone     String
  companyName      String?
  contactLocation  String
  consentAt        DateTime
  status           RequirementStatus @default(PENDING_REVIEW)
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  responses        RequirementResponse[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@map("requirements")
}

model RequirementResponse {
  id             String      @id @default(uuid())
  reference      String      @unique
  idempotencyKey String      @unique
  requirementId  String
  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  senderName     String
  senderEmail    String
  senderPhone    String?
  senderLocation String
  message        String
  consentAt      DateTime
  createdAt      DateTime    @default(now())

  @@index([requirementId])
  @@map("requirement_responses")
}

/// Admin-managed advertising. Served only when: status APPROVED, payment verified, inside [startsAt, endsAt),
/// and (if tied to an organisation) that organisation is active with a current subscription.
model AdCampaign {
  id              String            @id @default(uuid())
  placement       AdPlacementCode
  organisationId  String?
  organisation    Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  advertiserName  String
  headline        String
  description     String?
  ctaLabel        String            @default("Learn more")
  /// https:// URL or a site-relative path. Validated again at serve time.
  destinationUrl  String
  imageUrl        String?
  imageAlt        String?
  status          AdStatus          @default(DRAFT)
  paymentVerified Boolean           @default(false)
  startsAt        DateTime
  endsAt          DateTime
  /// Relative share when several campaigns compete for one slot.
  weight          Int               @default(1)
  impressions     Int               @default(0)
  clicks          Int               @default(0)
  isDemo          Boolean           @default(false)
  internalNotes   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([placement, status, startsAt, endsAt])
  @@map("ad_campaigns")
}

/// Back-office staff. Entirely separate from Organisations (brand accounts are not built yet).
model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  /// scrypt$N$r$p$salt$hash. Never returned by any API.
  passwordHash String
  role         AdminRole      @default(MODERATOR)
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions     AdminSession[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

/// Server-side session. Only the SHA-256 of the cookie token is stored.
model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Append-only record of every admin action that changes data.
model AuditLog {
  id         String     @id @default(uuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// e.g. "requirement.approve", "admin.login".
  action     String
  entityType String?
  entityId   String?
  /// Before/after values or a reason. Never contains secrets or contact details.
  meta       Json?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AnalyticsEventType {
  SEARCH
  CATEGORY_VIEW
  LISTING_VIEW
  PRODUCT_VIEW
  WHATSAPP_CLICK
  ENQUIRY
  REQUIREMENT
  LEAD
}

/// Anonymous usage events for the admin analytics. No IP address or cookie is stored:
/// `visitor` is a hash that changes every day, so it counts unique visitors per day and can't follow anyone.
model AnalyticsEvent {
  id            String             @id @default(uuid())
  type          AnalyticsEventType
  visitor       String             @db.VarChar(16)
  /// Which search box: distributors, brands, products or leads.
  scope         String?            @db.VarChar(20)
  /// Normalised (lower-case, trimmed) search keyword.
  query         String?            @db.VarChar(80)
  location      String?            @db.VarChar(80)
  /// Most specific category involved (a subcategory when one was chosen).
  categorySlug  String?            @db.VarChar(80)
  resultCount   Int?
  /// No foreign keys: history outlives deleted listings and products.
  distributorId String?
  productId     String?
  country       String?            @db.VarChar(2)
  device        String?            @db.VarChar(8)
  createdAt     DateTime           @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([distributorId, type])
  @@map("analytics_events")
}
