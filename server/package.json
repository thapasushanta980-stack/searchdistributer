{
  "name": "@sd/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch-path=./src src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/modules/public-eligibility.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:fixtures": "tsx prisma/dev-fixtures.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "admin:create:prod": "node dist/create-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@sd/shared": "*",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.7",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.0",
    "sirv": "^3.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.0",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
