# Production values for searchdistributor.online (set in Coolify):
#   SITE_URL=https://searchdistributor.online
#   MAIL_FROM="Search Distributor <no-reply@searchdistributor.online>"
# The values below are for rehearsing a deploy locally with docker-compose.prod.yml. On Coolify, set these in the UI instead.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
SITE_URL=http://localhost:3000
APP_PORT=3000

# Mail (without SMTP_HOST, confirmation emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Search Distributor <no-reply@localhost>"
SUPPORT_EMAIL=

# S3-compatible storage (required for admin image uploads).
# Example values are documented in docs/DEPLOY.md. Endpoint is the S3 API URL;
# public URL is the bucket's public domain/CDN URL. Keep blank until configured.
MEDIA_BUCKET=
MEDIA_REGION=auto
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
