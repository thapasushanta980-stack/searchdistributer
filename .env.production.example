# For rehearsing a deploy locally with docker-compose.prod.yml. On Coolify, set these in the UI instead.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
SITE_URL=http://localhost:3000
APP_PORT=3000

# Mail (without SMTP_HOST, confirmation emails are only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Search Distributor <no-reply@localhost>"
SUPPORT_EMAIL=
