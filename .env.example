# --- Server ---
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://distributor:distributor@localhost:5433/search_distributor?schema=public

# Public listings flagged isDemo (local fixtures) are only visible when this is true. Keep false in production.
SHOW_DEMO_DATA=true

# Enquiry email verification (PRD ENQ-02). When true the brand only receives the enquiry after the sender confirms their email.
ENQUIRY_EMAIL_VERIFICATION=true

# Currency used for the investment-range filter when records do not specify one (ISO 4217).
DEFAULT_CURRENCY=USD

# Outgoing mail. Leave SMTP_HOST empty in development to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Search Distributor <no-reply@localhost>"
SUPPORT_EMAIL=

# Site identity (used in metadata, structured data and the footer). Leave blank until confirmed.
SITE_NAME=Search Distributor
SITE_TWITTER=
SITE_EDITOR_NAME=
SITE_EDITOR_ROLE=
SITE_EDITOR_BIO=
